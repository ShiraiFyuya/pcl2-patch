<Window x:Class="Pcl2Patch.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pcl2-patch" Height="780" Width="900" MinHeight="700" MinWidth="820"
        Background="#F5F6F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2B6CF6" />
        <SolidColorBrush x:Key="Ink" Color="#1B2436" />
        <SolidColorBrush x:Key="Muted" Color="#6B778C" />
        <SolidColorBrush x:Key="Line" Color="#E4E8EF" />
        <SolidColorBrush x:Key="Ok" Color="#1E9E5A" />
        <SolidColorBrush x:Key="Bad" Color="#D64545" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F58D6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#B7C5DC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#33415C" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#D9DFE9" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9AA6BA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#E7ECF3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#33415C" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 头部 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="pcl2-patch" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                       Text="按步骤完成：选择文件 → 体检 → 打补丁 → 完成" />
        </StackPanel>

        <!-- ===================== 步骤条 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border x:Name="Dot1" Style="{StaticResource StepDot}">
                    <TextBlock x:Name="Num1" Text="1" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Lab1" Text="选择文件" Style="{StaticResource StepText}" />
            </StackPanel>

            <Rectangle Grid.Column="1" x:Name="Line1" Height="2" Margin="10,0" Fill="#E7ECF3" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border x:Name="Dot2" Style="{StaticResource StepDot}">
                    <TextBlock x:Name="Num2" Text="2" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Lab2" Text="体检结果" Style="{StaticResource StepText}" />
            </StackPanel>

            <Rectangle Grid.Column="3" x:Name="Line2" Height="2" Margin="10,0" Fill="#E7ECF3" VerticalAlignment="Center" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Border x:Name="Dot3" Style="{StaticResource StepDot}">
                    <TextBlock x:Name="Num3" Text="3" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Lab3" Text="确认并执行" Style="{StaticResource StepText}" />
            </StackPanel>

            <Rectangle Grid.Column="5" x:Name="Line3" Height="2" Margin="10,0" Fill="#E7ECF3" VerticalAlignment="Center" />

            <StackPanel Grid.Column="6" Orientation="Horizontal">
                <Border x:Name="Dot4" Style="{StaticResource StepDot}">
                    <TextBlock x:Name="Num4" Text="4" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Lab4" Text="完成" Style="{StaticResource StepText}" />
            </StackPanel>
        </Grid>

        <!-- ===================== 内容面板 ===================== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">

            <!-- ===== 第 1 步：选择文件 ===== -->
            <Border x:Name="Panel1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
                          Background="Transparent" Cursor="Hand" MouseLeftButtonUp="DropArea_Click">
                        <Rectangle RadiusX="10" RadiusY="10" Stroke="#C7D2E0" StrokeThickness="2"
                                   StrokeDashArray="4 3" Fill="#FAFBFD" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="把启动器 exe 拖到这里" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                       Text="支持原版 PCL2（2.99.0.0 / 2.99.0.1）与 PCL-CE（2.15.1）" />
                            <Button x:Name="BtnBrowse" Style="{StaticResource GhostButton}" Content="浏览选择…"
                                    Click="BtnBrowse_Click" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="18,0,18,16" FontSize="12" Foreground="{StaticResource Muted}"
                               Text="文件不会被上传；工具只在本地读取，并在原文件旁边生成 .bak 备份。" />
                </Grid>
            </Border>

            <!-- ===== 第 2 步：体检结果 ===== -->
            <Grid x:Name="Panel2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 版本信息卡 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="KindLabel" Text="未知启动器" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" />
                                <Border x:Name="KindBadge" Margin="10,0,0,0" Padding="8,2" CornerRadius="4"
                                        Background="#EEF2F9" VerticalAlignment="Center">
                                    <TextBlock x:Name="KindBadgeText" Text="PCL2" FontSize="11"
                                               Foreground="#33415C" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="VersionLabel" Margin="0,6,0,0" FontSize="14" Foreground="#33415C"
                                       Text="版本 —" />
                            <TextBlock x:Name="FileInfo" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AdaptState" Text="—" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="AdaptHint" Margin="0,4,0,0" FontSize="12"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Muted}" Text="" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 选项 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,12,0,0">
                    <CheckBox x:Name="ChkAutoUpdate" Content="关闭静默自动更新" IsChecked="True" Margin="0,0,22,0" />
                    <CheckBox x:Name="ChkRowClick" Content="整合包版本行点击 → 安装" IsChecked="True" />
                </StackPanel>

                <!-- 逐项结果 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
                    <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Results">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F4F8" BorderThickness="0,0,0,1" Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Mark}" FontWeight="Bold"
                                                       Foreground="{Binding Color}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== 第 3 步：确认并执行 ===== -->
            <Grid x:Name="Panel3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="将要写入的内容" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="TargetLabel" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Text="目标 —" />
                        <TextBlock x:Name="ApplyList" Margin="0,8,0,0" FontSize="12" Foreground="#33415C"
                                   TextWrapping="Wrap" Text="" />
                        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Bad}"
                                   TextWrapping="Wrap"
                                   Text="写入前会自动在同目录生成 .bak 备份；打完不要点启动器的「检查更新」，否则会被官方版覆盖。" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                    <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="#4A5568"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <!-- ===== 第 4 步：完成 ===== -->
            <Border x:Name="Panel4" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DoneMark" Text="✓" FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource Ok}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DoneTitle" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Text="补丁已写入" />
                    <TextBlock x:Name="DoneDetail" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Text="" />
                    <TextBlock x:Name="BackupText" Margin="0,8,0,0" FontSize="12" Foreground="#33415C"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Text="" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnOpenFolder" Style="{StaticResource GhostButton}" Content="打开所在文件夹"
                                Click="BtnOpenFolder_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnAgain" Style="{StaticResource GhostButton}" Content="再处理一个文件"
                                Click="BtnAgain_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnCopyBackup" Style="{StaticResource GhostButton}" Content="复制备份路径"
                                Click="BtnCopyBackup_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== 底部操作栏 ===================== -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StepHint" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource Muted}" Text="第 1 步，共 4 步" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnBack" Style="{StaticResource GhostButton}" Content="上一步"
                        Click="BtnBack_Click" Margin="0,0,10,0" Visibility="Collapsed" />
                <Button x:Name="BtnNext" Style="{StaticResource PrimaryButton}" Content="下一步"
                        Click="BtnNext_Click" IsEnabled="False" />
                <Button x:Name="BtnProbe" Style="{StaticResource GhostButton}" Content="重新体检"
                        Click="BtnProbe_Click" Margin="10,0,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
